# healthcare-skills — optional environment variables
#
# All skills work fully offline by default. These keys unlock optional
# online lookups for a small number of skills. Copy this file to `.env`
# and fill in only what you need.

# ── clinical-eval: LLM-as-judge scoring (pick one) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── icd-snomed-map: full SNOMED-CT lookup ──
# Free UMLS account at https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=

# ── icd-snomed-map / fhir-bundle: public terminology fallback ──
# No key needed; this is the default and works out of the box.
FHIR_TX_URL=https://tx.fhir.org/r4

# ── audit-trail / deid-vault: optional Postgres/Supabase backend ──
# Leave blank to use the local SQLite default.
DATABASE_URL=

# ── deid-vault: required only if you enable re-identification ──
DEID_VAULT_KEY=
DEID_ENABLE_REID=false
